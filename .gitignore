# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

src/blender_mcp/config.py

local_tests/
/test_*.py
.pytest_cache/

supabase/

scripts/

# Legacy PyPI shim — built and published separately, see runbook
legacy-shim/

# Secrets: Premium keys live only as Edge Function secrets
.env
.env.*
supabase/.env
supabase/.temp/
*.pem
*.key
.secrets/

# Local Claude Code files: only project memory is version-controlled
# (.claude/CLAUDE.md + .claude/memory/). settings.local.json etc. stay local.
.claude/*
!.claude/CLAUDE.md
!.claude/memory/

# PersonalDocs is version-controlled in full, including its scripts/ dirs
!/PersonalDocs/**/scripts/
